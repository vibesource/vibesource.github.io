---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes')).sort((a,b) => b.data.date.localeCompare(a.data.date) || a.id.localeCompare(b.id));
---
<Base title="Field notes"><section class="page-intro container"><p class="eyebrow muted">THE NOTEBOOK / WORK IN PROGRESS</p><h1>Field notes<span class="dot">.</span></h1><p>Short updates from the workshop. What I tried, what changed, and what I learned along the way.</p></section><section class="container section compact"><div class="note-list notes-full">{notes.map(note=><a class="note-row" href={`/notes/${note.id}/`}><div class="note-meta"><span>{note.data.date}</span><span>{note.data.category}</span></div><h3>{note.data.title} <span>↗</span></h3><p>{note.data.excerpt}</p></a>)}</div></section></Base>
