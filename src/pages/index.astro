---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { notes } from '../data/notes';
const featured = projects.slice(0,4);
---
<Base>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-pulse"></span> AN INDEPENDENT ENGINEERING WORKSHOP</p>
      <h1>Built from<br/><em>curiosity<span class="dot">.</span></em></h1>
      <p class="hero-lede">An open workbench for software, artificial intelligence, connected systems, and whatever interesting question comes next.</p>
      <div class="hero-actions"><a class="button button-primary" href="/projects/">Explore the projects <span aria-hidden="true">↗</span></a><a class="button button-quiet" href="/about/">What is this place? <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="orbit orbit-1"></div><div class="orbit orbit-2"></div><div class="orbit orbit-3"></div><div class="orbital-core"><span>?</span></div><span class="art-label art-label-top">BUILD / TEST / REPEAT</span><span class="art-label art-label-bottom">NO FIXED DESTINATION_</span><span class="crosshair crosshair-a">+</span><span class="crosshair crosshair-b">+</span></div>
  </section>
  <div class="ticker"><div class="container ticker-inner"><span>01 / THE WORKSHOP</span><span>IDEAS IN MOTION</span><span>EST. WHENEVER CURIOSITY STRIKES</span></div></div>
  <section class="section container" id="projects">
    <div class="section-heading"><div><p class="eyebrow muted">ON THE WORKBENCH / 001</p><h2>Things taking shape<span class="dot">.</span></h2><p>Some useful. Some experimental. All still teaching me something.</p></div><a class="text-link" href="/projects/">All projects <span>↗</span></a></div>
    <div class="project-grid">
      {featured.map((project, i) => <a href={`/projects/${project.slug}/`} class:list={['project-card', `accent-${project.accent}`]}><div class="project-top"><span class="mini-label">{String(i+1).padStart(2,'0')} / {project.eyebrow}</span><span class="arrow">↗</span></div><div class="project-glyph" aria-hidden="true">{['⌁','✳','⎔','◈'][i]}</div><div class="project-bottom"><span class="project-status"><span class="status-dot"></span>{project.status}</span><h3>{project.name}</h3><p>{project.summary}</p></div></a>)}
    </div>
  </section>
  <section class="note-section"><div class="container note-layout"><div><p class="eyebrow muted">FROM THE NOTEBOOK / 002</p><h2>Notes from<br/>the <em>bench.</em></h2><p class="note-intro">Not polished research papers. Just decisions, discoveries, detours, and the occasional working answer.</p><a class="text-link" href="/notes/">Browse field notes ↗</a></div><div class="note-list">{notes.map(note => <a class="note-row" href={`/notes/${note.slug}/`}><div class="note-meta"><span>{note.date}</span><span>{note.category}</span></div><h3>{note.title} <span>↗</span></h3><p>{note.excerpt}</p></a>)}<p class="note-placeholder">More notes will appear here as the workshop grows.</p></div></div></section>
  <section class="manifesto container"><span class="eyebrow muted">A WORKSHOP, NOT A SHOWROOM</span><h2>Not everything needs<br/>to be <em>finished</em> to be worth sharing.</h2><a class="text-link" href="/about/">A little more about this place ↗</a></section>
</Base>
