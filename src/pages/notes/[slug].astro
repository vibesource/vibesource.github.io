---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const data = note.data;
---
<Base title={data.title} description={data.excerpt}>
  <article class="container article">
    <p class="eyebrow muted"><a href="/notes/">← FIELD NOTES</a> / {data.category} / {data.date}</p>
    <h1>{data.title}<span class="dot">.</span></h1>
    <p class="article-lede">{data.excerpt}</p>
    <div class="article-body"><Content /></div>
    <a class="text-link" href="/notes/">← Back to field notes</a>
  </article>
</Base>
